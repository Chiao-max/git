  mitm:
    - "marketing-aibox.v.mitvos.com"

  url-rewrite:
    - >-
      ^https?:\/\/marketing-aibox\.v\.mitvos\.com\/advertise\/ - reject-dict
    - >-
      ^https?:\/\/marketing-aibox\.v\.mitvos\.com\/payGuide\/halfScreenMulti\/(home|cache)\? - reject-dict
    - >-
      ^https?:\/\/marketing-aibox\.v\.mitvos\.com\/payGuide\/tabPage\? - reject-dict
