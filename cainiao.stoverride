name: |-
  菜鸟
desc: |-
  过滤菜鸟广告（首页搜索推荐、运营位、活动广告、Vip 卡片、龙泉本地生活内容与 39017 物料）
  转换自 Loon 插件 Cainiao_remove_ads.lpx（作者：小白脸）
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Cainiao.png

http:

  mitm:
    - "netflow-mtop.cainiao.com"
    - "nbcps-mtop.cainiao.com"
    - "cn-acs.m.cainiao.com"
    - "e2e-mtop.cainiao.com"
    - "longquan-mtop.cainiao.com"

  url-rewrite:
    - >-
      ^https?:\/\/nbcps-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.nbcps\.presentation\.fetch\.cn - reject
    - >-
      ^https?:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.index - reject
    - >-
      ^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.adkeyword\.get\.cn - reject
    - >-
      ^https?:\/\/cn-acs\.m\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads\.m?show - reject

  body-rewrite:
    - '^https?:\/\/(cn-acs\.m|e2e-mtop)\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch response-jq del(.data.data.data.mainSearch.bizData.searchContents, .data.data.data.operationList)'
    - '^https?:\/\/e2e-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.app\.e2e\.engine\.page\.fetch\.cn response-jq del(.data.data.banner, .data.data.activity, .data.data.vip)'
    - '^https?:\/\/longquan-mtop\.cainiao\.com\/gw\/mtop\.com\.cainiao\.longquan\.place\.getpageresourcecontent\.cn response-jq del(.data.result.placeContentMap["780001"].contentList)'
    - '^https?:\/\/netflow-mtop\.cainiao\.com\/gw\/mtop\.cainiao\.guoguo\.nbnetflow\.ads response-jq if .data.result[0].materialId == "39017" then . else .data = {} end'
